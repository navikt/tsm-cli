{
    "name": "teamsykmelding-cli",
    "type": "module",
    "scripts": {
        "tsc": "tsc",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "lint-staged": "lint-staged",
        "build": "bun x rimraf tsm-cli/bin/tsm && bun run build-cli && bun run sanity-check",
        "build-cli": "bun run src/build.ts",
        "sanity-check": "./tsm-cli/bin/tsm config --team=tsm && ./tsm-cli/bin/tsm --help",
        "prepare": "husky",
        "upgrade-interactive": "bun update --interactive",
        "postinstall": "bun run fmt package.json && echo \"oxfmted package.json\""
    },
    "dependencies": {
        "@inquirer/prompts": "^7.10.1",
        "@navikt/fnrvalidator": "^2.2.1",
        "@types/js-yaml": "^4.0.9",
        "chalk": "^5.6.2",
        "date-fns": "^4.4.0",
        "fs-extra": "^11.4.0",
        "js-yaml": "^4.3.0",
        "octokit": "^3.2.2",
        "open": "^11.0.0",
        "remeda": "^2.39.0",
        "simple-git": "^3.36.0",
        "yargs": "^18.1.0"
    },
    "devDependencies": {
        "@navikt/tsm-oxfmt": "^0.0.9",
        "@navikt/tsm-oxlint": "^0.0.4",
        "@types/bun": "^1.3.14",
        "@types/fs-extra": "^11.0.4",
        "@types/yargs": "^17.0.35",
        "husky": "^9.1.7",
        "lint-staged": "^17.2.0",
        "oxfmt": "^0.61.0",
        "oxlint": "^1.76.0",
        "oxlint-tsgolint": "^7.0.2001",
        "rimraf": "^6.1.3",
        "semver": "^7.8.5",
        "typescript": "^7.0.2"
    }
}
